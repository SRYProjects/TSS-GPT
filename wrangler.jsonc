{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tss-gpt",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.js",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sage-analytics",
      "database_id": "b8b99a88-7004-4a8a-ab7a-bcf1814923ab"
    }
  ]
}
